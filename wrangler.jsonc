{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "so-do-ban-tiec",
  "compatibility_date": "2025-09-01",
  "main": "src/worker.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "so-do-ban-tiec",
      "database_id": "39006f30-c48e-4956-826e-c4a1c90d9c4c"
    }
  ]
}
